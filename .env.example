# Copy to .env (git-ignored) and fill in. Read only by the backend; never sent to the browser.

# LLM key for question generation and written-expression scoring: Claude or Gemini (either one).
# Without one, the screening uses the validated starter items and skips writing scores.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional
# LEXPACE_LLM_PROVIDER=gemini        # claude | gemini, when both keys are set
# LEXPACE_LLM_MODEL=claude-opus-5-5   # default for Gemini: gemini-3.5-flash
# LEXPACE_LLM=0                     # turn LLM generation off even when a key is set
# LEXPACE_LLM_FALLBACKS=0           # turn off server-side refusal fallback
# LEXPACE_CLASSIFIER_MODEL=backend/models/screening_model.json   # trained multi-label model export
# LEXPACE_CLASSIFIER=my_package.module:factory                   # or a Python factory
